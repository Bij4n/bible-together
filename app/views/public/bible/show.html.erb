<% book_name = I18n.locale == :es ? @book.name_es : @book.name_en %>

<% red = @lens == :red %>
<article class="relative mx-auto max-w-3xl space-y-8 <%= "red-lens" if red %>"<%= ' data-controller="red-lens"'.html_safe if red %>>
  <header class="space-y-4 border-b border-surface-200 pb-6">
    <% if @passage %>
      <%= render "bible/reader/passage_controls" %>
    <% else %>
      <div class="reader-controls flex flex-wrap items-center gap-2">
        <%= render "bible/reader/book_picker", translation: @translation, book: @book, layer: "community" %>
        <% chapter_numbers = reader_chapter_numbers(@book) %>
        <% if chapter_numbers.size > 1 %>
          <%= render "shared/nav_select",
                     options: chapter_numbers.map { |number|
                       [ "#{t('bible.reader.chapter_label')} #{number}",
                         reader_chapter_path(translation: @translation.code.downcase, book: @book.osis_code.downcase, chapter: number, layer: "community") ]
                     },
                     selected_url: reader_chapter_path(translation: @translation.code.downcase, book: @book.osis_code.downcase, chapter: @chapter.number, layer: "community"),
                     aria_label: t("bible.reader.chapter_label") %>
        <% end %>
        <% translations = Translation.order(:name) %>
        <% if translations.size > 1 %>
          <%= render "shared/nav_select",
                     options: translations.map { |t|
                       [ t.name, reader_chapter_path(translation: t.code.downcase, book: @book.osis_code.downcase, chapter: @chapter.number, layer: "community") ]
                     },
                     selected_url: reader_chapter_path(translation: @translation.code.downcase, book: @book.osis_code.downcase, chapter: @chapter.number, layer: "community"),
                     aria_label: t("bible.reader.translation_picker") %>
        <% end %>
        <% if user_signed_in? %>
          <div class="w-full sm:ms-auto sm:w-auto">
            <%= render "bible/reader/layer_switcher",
                       translation: @translation, book: @book, chapter: @chapter,
                       selected_url: reader_chapter_path(translation: @translation.code.downcase, book: @book.osis_code.downcase, chapter: @chapter.number, layer: "community") %>
          </div>
        <% end %>
      </div>
    <% end %>
    <%= render "bible/reader/red_lens_bar", translation: @translation, book: @book, chapter: @chapter, verses: @verses %>
    <%= render "bible/reader/title", book_name: book_name %>
    <p class="max-w-2xl pt-1 font-reading text-sm leading-[1.6] text-pretty text-surface-600">
      <%= t("public_bible.intro") %>
    </p>
    <% if user_signed_in? && !@passage %>
      <p class="font-ui text-sm text-surface-600">
        <%= link_to t("public_bible.switch_to_my_bible"),
                    reader_chapter_path(translation: @translation.code.downcase,
                                       book: @book.osis_code.downcase,
                                       chapter: @chapter.number),
                    class: "underline underline-offset-2 transition-colors hover:text-accent-700" %>
      </p>
    <% end %>
  </header>

  <div class="chapter-body font-reading <%= red ? "text-surface-500" : "text-surface-900" %>">
    <% chip_map = verse_note_map(@highlights) %>
    <% @verses.each_with_index do |verse, i| %><% meta = chip_map[verse.id] %><% note_chip = meta[:ids].any? ? { count: meta[:ids].size, href: "#note_#{meta[:ids].first}", color: meta[:color], label: meta[:label] } : nil %><%= render partial: "bible/reader/verse", locals: { verse: verse, highlights: @highlights, highlight_style: :underline, chapter_opener: i == 0, note_chip: note_chip } %><%= " " unless i == @verses.size - 1 %><% end %>
  </div>

  <%= render "bible/reader/passage_nav" if @passage %>

  <aside id="public_notes_aside" class="space-y-4">
    <h2 class="font-ui text-lg font-semibold tracking-tight text-surface-900">
      <%= t("public_bible.community_notes") %>
    </h2>

    <% if @public_notes.any? %>
      <ul id="public_notes_list" class="space-y-4">
        <% @public_notes.each do |note| %>
          <%= render partial: "public/bible/note", locals: { note: note } %>
        <% end %>
      </ul>
    <% else %>
      <p class="font-ui text-sm text-surface-600">
        <%= t("public_bible.no_notes_yet") %>
        <% unless user_signed_in? %>
          <%= link_to t("public_bible.sign_in_to_add"), new_user_session_path,
                      class: "ml-1 underline underline-offset-2 transition-colors hover:text-accent-700" %>
        <% end %>
      </p>
    <% end %>
  </aside>
</article>
