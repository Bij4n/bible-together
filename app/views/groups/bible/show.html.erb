<% book_name = I18n.locale == :es ? @book.name_es : @book.name_en %>
<% debug_selection = Rails.env.development? || params[:debug] == "1" %>

<% red = red_lens_dimmed? %>
<article class="relative mx-auto max-w-3xl space-y-8 <%= "red-lens" if red %>"
         data-controller="highlight<%= " red-lens" if red %>"
         data-highlight-translation-code-value="<%= @translation.code %>"
         data-highlight-book-value="<%= @book.osis_code %>"
         data-highlight-chapter-value="<%= @chapter.number %>"
         data-highlight-debug-value="<%= debug_selection %>">

  <%= turbo_stream_from @group, "bible", @translation.code, @book.osis_code, @chapter.number,
                        channel: "GroupBibleChannel" %>

  <nav aria-label="breadcrumb" class="flex items-center gap-2 font-ui text-xs text-surface-600">
    <%= link_to t("bible.reader.breadcrumb_home"), root_path, class: "transition-colors hover:text-accent-700" %>
    <span aria-hidden="true">&rsaquo;</span>
    <%= link_to @group.name, group_path(@group), class: "transition-colors hover:text-accent-700" %>
    <span aria-hidden="true">&rsaquo;</span>
    <span class="text-surface-900"><%= @passage ? @passage.title : "#{book_name} #{@chapter.number}" %></span>
  </nav>

  <header class="space-y-3 border-b border-surface-200 pb-6">
    <div class="flex items-center justify-between gap-3">
      <p class="font-ui text-xs font-medium uppercase tracking-wider text-surface-500">
        <%= @translation.name %>
      </p>
      <% if @passage %>
        <% if @appearances.size > 1 %>
          <nav aria-label="<%= t("red.parables.told_in") %>" class="passage-tellings flex flex-wrap items-center gap-1 font-ui text-sm">
            <% @appearances.each do |appearance| %>
              <% current = appearance == @appearance %>
              <%= link_to passage_reference(appearance), study_passage_path(@group, @passage, appearance),
                          aria: { current: (current ? "page" : nil) },
                          class: "rounded-full border px-3 py-1 transition-colors #{current ? 'border-surface-900 bg-surface-900 text-surface-50' : 'border-surface-300 text-surface-700 hover:bg-surface-100'}" %>
            <% end %>
          </nav>
        <% end %>
      <% else %>
        <%= render "bible/reader/layer_switcher",
                   translation: @translation, book: @book, chapter: @chapter,
                   selected_url: group_bible_chapter_path(@group, translation: @translation.code.downcase, book: @book.osis_code.downcase, chapter: @chapter.number) %>
      <% end %>
    </div>
    <%= render "bible/reader/red_lens_bar", translation: @translation, book: @book, chapter: @chapter, verses: @verses, study: true if @lens == :red %>
    <%= render "bible/reader/title", book_name: book_name %>
    <% if @passage %>
      <%# Where the study is. A manager can move it here. %>
      <div class="study-here font-ui text-sm">
        <% if @group.current_passage_record == @passage %>
          <span class="rounded-full bg-accent-100 px-2.5 py-0.5 text-xs font-medium text-accent-800"><%= t("groups.reading_list.we_are_here") %></span>
        <% elsif @group.manager?(current_user) %>
          <%= button_to t("groups.reading_list.mark_here"), current_passage_group_path(@group, slug: @passage.slug), method: :patch,
                        form_class: "inline",
                        class: "rounded-full border border-surface-300 px-3 py-1 text-surface-700 transition-colors hover:bg-surface-100" %>
        <% end %>
      </div>
    <% end %>
  </header>

  <div class="chapter-body font-reading <%= red ? "text-surface-500" : "text-surface-900" %>"
       data-highlight-target="chapter">
    <% chip_map = verse_note_map(@highlights) %>
    <% @verses.each_with_index do |verse, i| %><% meta = chip_map[verse.id] %><% note_chip = meta[:ids].any? ? { count: meta[:ids].size, href: "#note_#{meta[:ids].first}", color: meta[:color], label: meta[:label] } : nil %><%= render partial: "bible/reader/verse", locals: { verse: verse, highlights: @highlights, chapter_opener: i == 0, note_chip: note_chip } %><%= " " unless i == @verses.size - 1 %><% end %>
  </div>

  <% if user_signed_in? %>
    <%= render "bible/reader/toolbar" %>
  <% end %>

  <% if @passage %>
    <% previous_passage, next_passage = study_passage_neighbours(@group, @passage) %>
    <nav aria-label="<%= study_reading_list_title(@group) %>" class="study-passage-nav flex items-start justify-between gap-6 border-t border-surface-200 pt-6 font-ui text-sm">
      <% if previous_passage %>
        <%= link_to study_passage_path(@group, previous_passage),
                    class: "inline-flex items-center gap-1 text-surface-600 transition-colors hover:text-accent-700" do %>
          <span aria-hidden="true">&larr;</span>
          <%= previous_passage.title %>
        <% end %>
      <% else %>
        <span aria-hidden="true"></span>
      <% end %>
      <% if next_passage %>
        <%= link_to study_passage_path(@group, next_passage),
                    class: "inline-flex items-center gap-1 text-right text-surface-600 transition-colors hover:text-accent-700" do %>
          <%= next_passage.title %>
          <span aria-hidden="true">&rarr;</span>
        <% end %>
      <% end %>
    </nav>
  <% elsif red %>
    <% prev_stop, next_stop = reader_neighbours(@chapter) %>
    <nav aria-label="<%= t("bible.reader.chapter_label") %>" class="study-chapter-nav flex items-center justify-between border-t border-surface-200 pt-6 font-ui text-sm">
      <% if prev_stop %>
        <%= link_to group_bible_chapter_path(@group, translation: @translation.code.downcase, **prev_stop),
                    class: "inline-flex items-center gap-1 text-surface-600 transition-colors hover:text-accent-700" do %>
          <span aria-hidden="true">&larr;</span>
          <%= t("bible.reader.prev_chapter") %>
        <% end %>
      <% else %>
        <span aria-hidden="true"></span>
      <% end %>
      <% if next_stop %>
        <%= link_to group_bible_chapter_path(@group, translation: @translation.code.downcase, **next_stop),
                    class: "inline-flex items-center gap-1 text-surface-600 transition-colors hover:text-accent-700" do %>
          <%= t("bible.reader.next_chapter") %>
          <span aria-hidden="true">&rarr;</span>
        <% end %>
      <% end %>
    </nav>
  <% end %>

  <aside id="group_notes_aside"
         class="rounded-2xl border border-surface-200 bg-surface-50 p-5 <%= "hidden" if @group_notes.empty? %>">
    <h2 class="font-ui text-lg font-semibold tracking-tight text-surface-900">
      <%= t("bible.reader.group_notes") %>
    </h2>
    <ul id="group_notes_list" class="mt-3 space-y-4">
      <% @group_notes.each do |note| %>
        <%= render partial: "groups/bible/note", locals: { note: note } %>
      <% end %>
    </ul>
  </aside>
</article>
