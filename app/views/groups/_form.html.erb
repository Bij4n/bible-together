<%
  label_classes  = "mb-1.5 block font-ui text-sm font-medium text-surface-900"
  input_classes  = "w-full rounded-md border border-surface-300 bg-surface-50 px-3 py-2 font-ui text-sm text-surface-900 transition-colors placeholder:text-surface-500 focus:border-accent-700 focus:outline-none focus:ring-2 focus:ring-accent-700/20"
  radio_classes  = "h-4 w-4 accent-accent-700"
  submit_classes = "rounded-full bg-accent-700 px-5 py-2 font-ui text-sm font-medium text-surface-50 transition-colors hover:bg-accent-800"
  cancel_classes = "font-ui text-sm text-surface-600 transition-colors hover:text-accent-700"
%>

<%= form_with model: group, class: "space-y-5" do |f| %>
  <% if group.errors.any? %>
    <div role="alert" class="rounded-md border border-red-200 bg-red-50 px-4 py-3 font-ui text-sm text-red-800">
      <ul class="list-inside list-disc space-y-1">
        <% group.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: label_classes %>
    <%= f.text_field :name, required: true, maxlength: 100, class: input_classes %>
  </div>

  <div>
    <%= f.label :description, class: label_classes %>
    <%= f.text_area :description, rows: 3, maxlength: 500, class: input_classes %>
  </div>

  <fieldset class="space-y-2">
    <legend class="<%= label_classes %>"><%= Group.human_attribute_name(:privacy) %></legend>
    <% Group::PRIVACIES.keys.each do |key| %>
      <label class="flex items-center gap-2 font-ui text-sm text-surface-700">
        <%= f.radio_button :privacy, key, class: radio_classes %>
        <%= t("groups.privacy.#{key}") %>
      </label>
    <% end %>
  </fieldset>

  <%# One choice for what the study reads: the whole Bible, Highlighted
      in Red chapter by chapter, or one of the lists or themes read a
      passage at a time. %>
  <div>
    <%= f.label :plan, t("groups.focus.label"), class: label_classes %>
    <%= f.select :plan,
                 options_for_select([ [ t("groups.plan.bible"), "bible" ], [ t("groups.plan.red"), "red" ] ], group.plan) +
                 grouped_options_for_select(
                   { t("groups.reading_list.lists_group") => Bible::Passages::COLLECTIONS.keys.map { |list| [ t("red.#{list}.title"), list ] },
                     t("groups.reading_list.themes_group") => Bible::Themes.all.map { |theme| [ theme.name, "#{Group::THEME_PREFIX}#{theme.slug}" ] } },
                   group.plan
                 ),
                 {},
                 class: "#{input_classes} [&_option]:bg-surface-50 [&_option]:text-surface-900" %>
    <p class="mt-1.5 font-ui text-xs text-surface-600"><%= t("groups.plan.hint") %></p>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to t("groups.cancel"), groups_path, class: cancel_classes %>
    <%= f.submit class: submit_classes %>
  </div>
<% end %>
