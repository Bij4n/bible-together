<%# Heads the verses where Jesus explains a parable himself, shown
    under the telling on a passage page. Sits between verses and is
    skipped by text selection. %>
<span data-ignore-selection
      class="passage-explanation mb-1 mt-8 block border-t border-surface-200 pt-6 font-ui text-xs font-semibold uppercase tracking-wide text-surface-600"><%= t("red.explained") %></span>
