<% content_for :title, t("red.#{@collection}.title") %>
<% content_for :meta_description, t("red.#{@collection}.intro") %>

<article class="mx-auto max-w-2xl space-y-12 sm:space-y-14">
  <%= render "red/shared/header", title: t("red.#{@collection}.title"), intro: t("red.#{@collection}.intro") %>

  <% @groups.each do |group| %>
    <%= render "red/passages/list", **group %>
  <% end %>
</article>
