<%# Header for the list pages in Highlighted in Red.
    locals: title, intro %>
<header class="space-y-5">
  <p class="font-ui text-xs font-semibold uppercase tracking-wide text-jesus-light">
    <%= link_to t("bible.reader.red.eyebrow"), red_entry_path, class: "hover:underline" %>
  </p>
  <h1 class="font-ui text-4xl font-semibold tracking-[-0.03em] text-surface-900 sm:text-5xl">
    <%= title %>
  </h1>
  <p class="font-reading text-xl leading-relaxed text-pretty text-surface-700">
    <%= intro %>
  </p>
  <%= render "red/shared/sections" %>
</header>
