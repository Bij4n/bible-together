<%# Dashboard card for Highlighted in Red, for members. %>
<section data-section="highlighted-in-red" class="rounded-2xl border border-surface-200 bg-surface-50 p-6 sm:p-8" aria-labelledby="dashboard-red-heading">
  <h2 id="dashboard-red-heading" class="font-ui text-sm font-semibold uppercase tracking-wide text-jesus-light">
    <%= t("home.red.heading") %>
  </h2>
  <p class="mt-3 max-w-2xl font-reading text-base leading-relaxed text-pretty text-surface-700">
    <%= t("home.red.body") %>
  </p>
  <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 font-ui text-sm">
    <%= link_to t("home.red.cta"), red_home_path,
        class: "inline-flex items-center rounded-full bg-accent-700 px-5 py-2.5 font-medium text-surface-50 transition-colors hover:bg-accent-800" %>
    <% quiet_link = "text-surface-600 underline underline-offset-2 transition-colors hover:text-accent-700" %>
    <%= link_to t("red.home.doors.words.title"), red_words_path, class: quiet_link %>
    <%= link_to t("red.home.doors.parables.title"), red_passages_path(collection: "parables"), class: quiet_link %>
    <%= link_to t("red.home.doors.encounters.title"), red_passages_path(collection: "encounters"), class: quiet_link %>
  </div>
</section>
